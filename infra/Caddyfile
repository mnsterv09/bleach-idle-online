# SITE_ADDRESS: ":80" atrás da Cloudflare (modo Flexible) ou o domínio, ex. "jogo.exemplo.com",
# para o Caddy emitir certificado sozinho (modo Full strict).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@game path /ws /health
	handle @game {
		reverse_proxy server:3001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
